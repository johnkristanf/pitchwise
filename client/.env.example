# ==============================================================================
# PitchWise Client Environment Variables
# Copy this file to .env or .env.local and populate the values below.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Modern Supabase Publishable Key (format starts with sb_pub_...)
# NOTE: Do NOT use legacy SUPABASE_ANON_KEY static JWTs. Use the modern publishable API key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub_your_publishable_api_key_here

